// Gruvbox-themed fastfetch, matching the Limine and icon theme.
// Colors: yellow fabd2f, aqua 8ec07c, blue 83a598, orange fe8019, gray 928374.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos",
    "color": {
      "1": "38;2;131;165;152",
      "2": "38;2;142;192;124",
      "3": "38;2;131;165;152",
      "4": "38;2;142;192;124",
      "5": "38;2;131;165;152",
      "6": "38;2;142;192;124"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;250;189;47",
      "title": "38;2;254;128;25",
      "output": "38;2;235;219;178"
    },
    "key": { "width": 13 },
    "bar": {
      "char": { "elapsed": "■", "total": "■" },
      "border": { "left": "", "right": "" },
      "color": { "total": "38;2;80;73;69" },
      "width": 12
    },
    "percent": {
      "type": ["num", "bar"],
      "color": {
        "green": "38;2;184;187;38",
        "yellow": "38;2;250;189;47",
        "red": "38;2;251;73;52"
      }
    },
    "size": { "binaryPrefix": "iec", "ndigits": 1 }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1}󱄅  {#38;2;254;128;25}{user-name}{#38;2;146;131;116}@{#38;2;142;192;124}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}╭─────────────── {#38;2;131;165;152}system{#38;2;146;131;116} ───────────────"
    },
    { "type": "os",       "key": "│ 󱄅 os",     "keyColor": "38;2;131;165;152", "format": "{pretty-name}" },
    { "type": "kernel",   "key": "│ 󰌽 kernel", "keyColor": "38;2;131;165;152" },
    { "type": "packages", "key": "│ 󰏖 pkgs",   "keyColor": "38;2;131;165;152", "format": "{nix-system} sys · {nix-user} user · {flatpak-all} flatpak" },
    { "type": "uptime",   "key": "│ 󰔟 uptime", "keyColor": "38;2;131;165;152" },
    { "type": "shell",    "key": "│ 󰆍 shell",  "keyColor": "38;2;131;165;152" },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}├─────────────── {#38;2;142;192;124}desktop{#38;2;146;131;116} ──────────────"
    },
    { "type": "de",       "key": "│ 󰕮 de",     "keyColor": "38;2;142;192;124" },
    { "type": "wm",       "key": "│ 󰖲 wm",     "keyColor": "38;2;142;192;124" },
    { "type": "icons",    "key": "│ 󰀻 icons",  "keyColor": "38;2;142;192;124", "format": "{1}" },
    { "type": "cursor",   "key": "│ 󰇀 cursor", "keyColor": "38;2;142;192;124" },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}├─────────────── {#38;2;254;128;25}hardware{#38;2;146;131;116} ─────────────"
    },
    { "type": "host",     "key": "│ 󰍹 board",  "keyColor": "38;2;254;128;25" },
    { "type": "cpu",      "key": "│ 󰻠 cpu",    "keyColor": "38;2;254;128;25", "temp": true, "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu",      "key": "│ 󰢮 gpu",    "keyColor": "38;2;254;128;25", "format": "{name}" },
    { "type": "display",  "key": "│ 󰍺 display","keyColor": "38;2;254;128;25", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "memory",   "key": "│ 󰑭 ram",    "keyColor": "38;2;254;128;25", "format": "{percentage-bar}  {used} / {total} ({percentage})" },
    { "type": "disk",     "key": "│ 󰋊 disk",   "keyColor": "38;2;254;128;25", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total} ({size-percentage})" },
    {
      "type": "custom",
      "format": "{#38;2;146;131;116}╰──────────────────────────────────────────"
    },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
