# Mako notification daemon configuration
# Deployed to ~/.config/mako/config via systemd.tmpfiles in
# modules/desktop.nix. Squared, sharp, no rounded corners.
#
# Anchored top-center to match the custom polkit dialog (PolkitDialog.qml)
# so both "system popup" surfaces show up in the same place.

background-color=#0d0d0dee
text-color=#e0e0e0ff
border-color=#333333ff
border-size=2
border-radius=0
padding=10
margin=12
width=420
font=JetBrainsMono Nerd Font 10
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-center

[urgency=low]
border-color=#333333ff

[urgency=normal]
border-color=#8fbcbbff

[urgency=critical]
border-color=#e06c75ff
default-timeout=0
